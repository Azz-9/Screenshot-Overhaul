{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",

    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
		"issues": "${issues}",
		"sources": "${sources}"
    },

    "license": "${license}",
    "icon": "${mod_id}.png",

	"environment": "client",
    "entrypoints": {
        "main": [
			"me.Azz_9.screenshot_overhaul.ScreenshotOverhaul"
        ],
		"modmenu": [
			"me.Azz_9.screenshot_overhaul.compat.ModMenuCompat"
		]
    },

	"mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json",
        "${mod_id}.xaero.mixins.json"
    ],

	"depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
		"minecraft": "${minecraft_compatibility}",
        "java": ">=${java_version}"
    }
}
  